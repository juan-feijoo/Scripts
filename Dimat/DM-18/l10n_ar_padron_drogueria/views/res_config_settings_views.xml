<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_drogueria" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.drogueria</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='account_vendor_bills']" position="after">
                <block title="Padrón ARBA Droguerías (RN 42/12)" id="arba_droguerias_setting">
                    <setting string="Piso Mínimo de Retención" help="Alícuota mínima legal de retención a aplicar a droguerías según Resolución Normativa ARBA 42/12.">
                        <field name="l10n_ar_drogueria_min_retention"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
