<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_ot_taller_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.basic_layout">
                    <div class="page" style="font-family: Arial, Helvetica, sans-serif; font-size: 10px; color: #111;">
                        
                        <!-- ENCABEZADO -->
                        <table style="width: 100%; border-collapse: collapse; margin-bottom: 6px; border: 1px solid #005a9c;">
                            <tr>
                                <td style="width: 20%; text-align: center; vertical-align: middle; border: 1px solid #005a9c; padding: 4px;">
                                    <span t-if="doc.company_id.logo" t-field="doc.company_id.logo" t-options="{'widget': 'image', 'style': 'max-height: 45px; max-width: 120px;'}"/>
                                    <span t-else="" style="font-weight: bold; font-size: 16px; color: #005a9c;">FMF GROUP</span>
                                </td>
                                <td style="width: 60%; text-align: center; vertical-align: middle; border: 1px solid #005a9c; padding: 4px;">
                                    <div style="font-size: 12px; font-weight: bold; color: #005a9c;">
                                        <span t-if="doc.tipo_ot == 'tmec_01'">OT - TMEC - 01 - TRACTOR / EQUIPO DE ARRASTRE</span>
                                        <span t-else="">OT - TMEC - 02 - UNIDAD LIVIANA</span>
                                        <br/>SOLICITUD DE TRABAJO - TALLER MECANICO
                                    </div>
                                </td>
                                <td style="width: 20%; font-size: 9px; border: 1px solid #005a9c; padding: 4px;">
                                    <strong>REV:</strong> 9<br/>
                                    <strong>FECHA:</strong> <span t-field="doc.create_date" t-options='{"format": "dd/MM/yyyy"}'/><br/>
                                    <strong>HORA:</strong> <span t-esc="doc.hora_ot or '10:30'"/><br/>
                                    <strong>N° O.T.:</strong> <strong style="font-size: 12px; color: red;"><span t-esc="doc.numero_ot or doc.id"/></strong>
                                </td>
                            </tr>
                        </table>

                        <!-- DATOS DE FLOTA (TRACTOR / ARRASTRE O LIVIANO) -->
                        <t t-if="doc.tipo_ot == 'tmec_01'">
                            <table style="width: 100%; border-collapse: collapse; margin-bottom: 6px; border: 1px solid #005a9c; font-size: 9px;">
                                <tr style="background-color: #e6f0fa; font-weight: bold; color: #005a9c;">
                                    <td colspan="2" style="width: 40%; border: 1px solid #005a9c; padding: 3px;">DATOS DE TRACTOR</td>
                                    <td style="width: 20%; border: 1px solid #005a9c; padding: 3px;">CONTROL GENERAL</td>
                                    <td colspan="2" style="width: 40%; border: 1px solid #005a9c; padding: 3px;">DATOS DE EQUIPO DE ARRASTRE</td>
                                </tr>
                                <tr>
                                    <td style="width: 12%; border: 1px solid #005a9c; padding: 3px;"><strong>DOMINIO:</strong></td>
                                    <td style="width: 28%; border: 1px solid #005a9c; padding: 3px;"><span t-esc="doc.sudo().tractor_dominio or ''"/></td>
                                    <td style="width: 20%; border: 1px solid #005a9c; padding: 3px;"><strong>CHOFER:</strong> <span t-esc="doc.sudo().chofer_id.name or doc.chofer_nombre or ''"/></td>
                                    <td style="width: 12%; border: 1px solid #005a9c; padding: 3px;"><strong>DOMINIO:</strong></td>
                                    <td style="width: 28%; border: 1px solid #005a9c; padding: 3px;"><span t-esc="doc.sudo().arrastre_dominio or ''"/></td>
                                </tr>
                                <tr>
                                    <td style="border: 1px solid #005a9c; padding: 3px;"><strong>ID:</strong></td>
                                    <td style="border: 1px solid #005a9c; padding: 3px;"><span t-esc="doc.sudo().tractor_id.name or ''"/></td>
                                    <td style="border: 1px solid #005a9c; padding: 3px;"><strong>KM ACTUAL:</strong> <span t-esc="'{:,.0f}'.format(doc.km_actual) if doc.km_actual else ''"/></td>
                                    <td style="border: 1px solid #005a9c; padding: 3px;"><strong>ID:</strong></td>
                                    <td style="border: 1px solid #005a9c; padding: 3px;"><span t-esc="doc.sudo().arrastre_id.name or ''"/></td>
                                </tr>
                                <tr>
                                    <td style="border: 1px solid #005a9c; padding: 3px;"><strong>MARCA:</strong></td>
                                    <td style="border: 1px solid #005a9c; padding: 3px;"><span t-esc="doc.sudo().tractor_marca or ''"/></td>
                                    <td style="border: 1px solid #005a9c; padding: 3px;"><strong>KM SERVICE:</strong> <span t-esc="'{:,.0f}'.format(doc.km_service) if doc.km_service else ''"/></td>
                                    <td style="border: 1px solid #005a9c; padding: 3px;"><strong>TIPO EQUIPO:</strong></td>
                                    <td style="border: 1px solid #005a9c; padding: 3px;"><span t-esc="doc.sudo().arrastre_tipo or ''"/></td>
                                </tr>
                                <tr>
                                    <td style="border: 1px solid #005a9c; padding: 3px;"><strong>MODELO:</strong></td>
                                    <td style="border: 1px solid #005a9c; padding: 3px;"><span t-esc="doc.sudo().tractor_modelo or ''"/></td>
                                    <td style="border: 1px solid #005a9c; padding: 3px;"><strong>REM KM:</strong> <span t-esc="'{:,.0f}'.format(doc.km_restantes) if doc.km_restantes else ''"/></td>
                                    <td style="border: 1px solid #005a9c; padding: 3px;"><strong>MODELO:</strong></td>
                                    <td style="border: 1px solid #005a9c; padding: 3px;"><span t-esc="doc.sudo().arrastre_modelo or ''"/></td>
                                </tr>
                                <tr>
                                    <td colspan="2" style="border: 1px solid #005a9c; padding: 3px;">
                                        <strong>OBSERVACIONES TRACTOR:</strong><br/>
                                        <span t-esc="doc.obs_tractor or 'Sin observaciones.'"/>
                                    </td>
                                    <td style="border: 1px solid #005a9c; padding: 3px;"></td>
                                    <td colspan="2" style="border: 1px solid #005a9c; padding: 3px;">
                                        <strong>OBSERVACIONES ARRASTRE:</strong><br/>
                                        <span t-esc="doc.obs_arrastre or 'Sin observaciones.'"/>
                                    </td>
                                </tr>
                            </table>
                        </t>

                        <t t-else="">
                            <!-- UNIDAD LIVIANA -->
                            <table style="width: 100%; border-collapse: collapse; margin-bottom: 6px; border: 1px solid #005a9c; font-size: 9px;">
                                <tr style="background-color: #e6f0fa; font-weight: bold; color: #005a9c;">
                                    <td colspan="4" style="border: 1px solid #005a9c; padding: 3px;">DATOS DE UNIDAD LIVIANA</td>
                                </tr>
                                <tr>
                                    <td style="border: 1px solid #005a9c; padding: 3px;"><strong>VEHÍCULO:</strong> <span t-esc="doc.sudo().vehiculo_liviano_id.display_name or ''"/></td>
                                    <td style="border: 1px solid #005a9c; padding: 3px;"><strong>DOMINIO:</strong> <span t-esc="doc.sudo().vehiculo_liviano_id.license_plate or ''"/></td>
                                    <td style="border: 1px solid #005a9c; padding: 3px;"><strong>KM ACTUAL:</strong> <span t-esc="doc.km_actual"/></td>
                                    <td style="border: 1px solid #005a9c; padding: 3px;"><strong>KM SERVICE:</strong> <span t-esc="doc.km_service"/></td>
                                </tr>
                                <tr>
                                    <td colspan="4" style="border: 1px solid #005a9c; padding: 3px;"><strong>OBSERVACIONES:</strong> <span t-esc="doc.obs_liviano or ''"/></td>
                                </tr>
                            </table>
                        </t>

                        <!-- RESUMEN DE CHECKLIST -->
                        <table style="width: 100%; border-collapse: collapse; margin-bottom: 6px; border: 1px solid #005a9c; font-size: 8px;">
                            <tr style="background-color: #005a9c; color: white; font-weight: bold; text-align: center;">
                                <td colspan="6" style="border: 1px solid #005a9c; padding: 3px;">RESUMEN DE INSPECCIÓN Y CHECKLIST (OK / NO / NA)</td>
                            </tr>
                            <tr style="background-color: #e6f0fa; font-weight: bold; color: #005a9c;">
                                <td style="width: 25%; border: 1px solid #005a9c; padding: 2px;">TRACTOR - FLUIDOS / MECÁNICA</td>
                                <td style="width: 8%; text-align: center; border: 1px solid #005a9c; padding: 2px;">ESTADO</td>
                                <td style="width: 25%; border: 1px solid #005a9c; padding: 2px;">TRACTOR - LUCES / SIST. ELÉCTRICO</td>
                                <td style="width: 8%; text-align: center; border: 1px solid #005a9c; padding: 2px;">ESTADO</td>
                                <td style="width: 26%; border: 1px solid #005a9c; padding: 2px;">ARRASTRE - FRENOS / AIRE / EJES</td>
                                <td style="width: 8%; text-align: center; border: 1px solid #005a9c; padding: 2px;">ESTADO</td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #005a9c; padding: 2px;">Nivel Aceite Motor</td><td style="text-align:center; border: 1px solid #005a9c;"><b><span t-esc="(doc.chk_tr_aceite_motor or '').upper()"/></b></td>
                                <td style="border: 1px solid #005a9c; padding: 2px;">Estado Batería y Bornes</td><td style="text-align:center; border: 1px solid #005a9c;"><b><span t-esc="(doc.chk_tr_bateria_bornes or '').upper()"/></b></td>
                                <td style="border: 1px solid #005a9c; padding: 2px;">Sistema Eléctrico y Luces</td><td style="text-align:center; border: 1px solid #005a9c;"><b><span t-esc="(doc.chk_ar_sistema_electrico or '').upper()"/></b></td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #005a9c; padding: 2px;">Líquido Refrigerante</td><td style="text-align:center; border: 1px solid #005a9c;"><b><span t-esc="(doc.chk_tr_liq_refrigerante or '').upper()"/></b></td>
                                <td style="border: 1px solid #005a9c; padding: 2px;">Luces Delanteras/Traseras</td><td style="text-align:center; border: 1px solid #005a9c;"><b><span t-esc="(doc.chk_tr_luces_delanteras_traseras or '').upper()"/></b></td>
                                <td style="border: 1px solid #005a9c; padding: 2px;">Frenos / Campanas / Discos</td><td style="text-align:center; border: 1px solid #005a9c;"><b><span t-esc="(doc.chk_ar_campanas_discos or '').upper()"/></b></td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #005a9c; padding: 2px;">Líquido de Frenos</td><td style="text-align:center; border: 1px solid #005a9c;"><b><span t-esc="(doc.chk_tr_liq_frenos or '').upper()"/></b></td>
                                <td style="border: 1px solid #005a9c; padding: 2px;">Luces Freno y Retroceso</td><td style="text-align:center; border: 1px solid #005a9c;"><b><span t-esc="(doc.chk_tr_luces_freno or '').upper()"/></b></td>
                                <td style="border: 1px solid #005a9c; padding: 2px;">Mangueras y Tanque de Aire</td><td style="text-align:center; border: 1px solid #005a9c;"><b><span t-esc="(doc.chk_ar_tanque_aire or '').upper()"/></b></td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #005a9c; padding: 2px;">Estado de Neumáticos</td><td style="text-align:center; border: 1px solid #005a9c;"><b><span t-esc="(doc.chk_tr_estado_neumaticos or '').upper()"/></b></td>
                                <td style="border: 1px solid #005a9c; padding: 2px;">Control Frenos / Pastillas</td><td style="text-align:center; border: 1px solid #005a9c;"><b><span t-esc="(doc.chk_tr_cintas_pastillas or '').upper()"/></b></td>
                                <td style="border: 1px solid #005a9c; padding: 2px;">Suspensión y Paquetes Elásticos</td><td style="text-align:center; border: 1px solid #005a9c;"><b><span t-esc="(doc.chk_ar_paq_elasticos_grampas or '').upper()"/></b></td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #005a9c; padding: 2px;">Fuga de Fluidos</td><td style="text-align:center; border: 1px solid #005a9c;"><b><span t-esc="(doc.chk_tr_fuga_fluidos or '').upper()"/></b></td>
                                <td style="border: 1px solid #005a9c; padding: 2px;">Mangueras y Cableado Motor</td><td style="text-align:center; border: 1px solid #005a9c;"><b><span t-esc="(doc.chk_tr_mangueras_cableado or '').upper()"/></b></td>
                                <td style="border: 1px solid #005a9c; padding: 2px;">Mazas / Rulemanes / Engrase</td><td style="text-align:center; border: 1px solid #005a9c;"><b><span t-esc="(doc.chk_ar_estado_mazas or '').upper()"/></b></td>
                            </tr>
                        </table>

                        <!-- DETALLE DE TRABAJOS REALIZADOS (TIMESHEET) -->
                        <table style="width: 100%; border-collapse: collapse; margin-bottom: 6px; border: 1px solid #005a9c; font-size: 9px;">
                            <tr style="background-color: #005a9c; color: white; font-weight: bold; text-align: center;">
                                <td colspan="4" style="border: 1px solid #005a9c; padding: 3px;">DETALLE DE TRABAJOS REALIZADOS</td>
                            </tr>
                            <tr style="background-color: #e6f0fa; font-weight: bold; color: #005a9c;">
                                <td style="width: 15%; border: 1px solid #005a9c; padding: 2px;">FECHA</td>
                                <td style="width: 15%; border: 1px solid #005a9c; padding: 2px;">HORAS DEDICADAS</td>
                                <td style="width: 45%; border: 1px solid #005a9c; padding: 2px;">DESCRIPCIÓN DE TAREAS</td>
                                <td style="width: 25%; border: 1px solid #005a9c; padding: 2px;">REALIZADO POR</td>
                            </tr>
                            <t t-if="doc.timesheet_ids">
                                <tr t-foreach="doc.timesheet_ids" t-as="ts">
                                    <td style="border: 1px solid #005a9c; padding: 2px;"><span t-field="ts.date" t-options='{"format": "dd/MM/yyyy"}'/></td>
                                    <td style="border: 1px solid #005a9c; padding: 2px;"><span t-field="ts.unit_amount"/> h</td>
                                    <td style="border: 1px solid #005a9c; padding: 2px;"><span t-field="ts.name"/></td>
                                    <td style="border: 1px solid #005a9c; padding: 2px;"><span t-esc="ts.sudo().employee_id.name or ''"/></td>
                                </tr>
                            </t>
                            <t t-else="">
                                <tr>
                                    <td colspan="4" style="text-align: center; color: #888; border: 1px solid #005a9c; padding: 4px;">No se registraron partes de horas aún.</td>
                                </tr>
                            </t>
                        </table>

                        <!-- REPUESTOS UTILIZADOS -->
                        <table style="width: 100%; border-collapse: collapse; margin-bottom: 6px; border: 1px solid #005a9c; font-size: 9px;">
                            <tr style="background-color: #005a9c; color: white; font-weight: bold; text-align: center;">
                                <td colspan="5" style="border: 1px solid #005a9c; padding: 3px;">REPUESTOS UTILIZADOS (ALMACÉN TALLER)</td>
                            </tr>
                            <tr style="background-color: #e6f0fa; font-weight: bold; color: #005a9c;">
                                <td style="width: 10%; text-align: center; border: 1px solid #005a9c; padding: 2px;">CANTIDAD</td>
                                <td style="width: 40%; border: 1px solid #005a9c; padding: 2px;">PRODUCTO / DESCRIPCIÓN</td>
                                <td style="width: 15%; border: 1px solid #005a9c; padding: 2px;">CÓDIGO</td>
                                <td style="width: 15%; border: 1px solid #005a9c; padding: 2px;">MEDIDAS</td>
                                <td style="width: 20%; border: 1px solid #005a9c; padding: 2px;">OBSERVACIONES</td>
                            </tr>
                            <t t-if="doc.repuesto_line_ids">
                                <tr t-foreach="doc.repuesto_line_ids" t-as="line">
                                    <td style="text-align: center; border: 1px solid #005a9c; padding: 2px;"><strong><span t-field="line.product_uom_qty"/></strong></td>
                                    <td style="border: 1px solid #005a9c; padding: 2px;"><span t-esc="line.sudo().product_id.name or ''"/></td>
                                    <td style="border: 1px solid #005a9c; padding: 2px;"><span t-esc="line.sudo().default_code or ''"/></td>
                                    <td style="border: 1px solid #005a9c; padding: 2px;"><span t-field="line.medidas"/></td>
                                    <td style="border: 1px solid #005a9c; padding: 2px;"><span t-field="line.observaciones"/></td>
                                </tr>
                            </t>
                            <t t-else="">
                                <tr>
                                    <td colspan="5" style="text-align: center; color: #888; border: 1px solid #005a9c; padding: 4px;">Sin repuestos cargados.</td>
                                </tr>
                            </t>
                        </table>

                        <!-- FIRMAS Y AUTORIZACIÓN -->
                        <table style="width: 100%; border-collapse: collapse; margin-top: 15px; border: 1px solid #005a9c; font-size: 9px;">
                            <tr>
                                <td style="width: 50%; height: 60px; text-align: center; vertical-align: bottom; border: 1px solid #005a9c; padding: 4px;">
                                    <span t-if="doc.firma_supervisor" t-field="doc.firma_supervisor" t-options="{'widget': 'image', 'style': 'max-height: 45px; max-width: 150px;'}"/>
                                    <hr style="width: 80%; border-top: 1px solid #333; margin: 4px auto;"/>
                                    <strong>FIRMA SUPERVISOR DE TALLER MECÁNICO</strong><br/>
                                    <span t-esc="doc.sudo().supervisor_id.name or ''"/>
                                </td>
                                <td style="width: 50%; height: 60px; text-align: center; vertical-align: bottom; border: 1px solid #005a9c; padding: 4px;">
                                    <span t-if="doc.firma_jefe_taller" t-field="doc.firma_jefe_taller" t-options="{'widget': 'image', 'style': 'max-height: 45px; max-width: 150px;'}"/>
                                    <hr style="width: 80%; border-top: 1px solid #333; margin: 4px auto;"/>
                                    <strong>FIRMA JEFE DE TALLER MECÁNICO</strong><br/>
                                    <span t-esc="doc.sudo().jefe_taller_id.name or ''"/>
                                </td>
                            </tr>
                        </table>

                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
